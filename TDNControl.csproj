<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TDN_Control</AssemblyName>
    <RootNamespace>TDNControl</RootNamespace>
    <Version>1.0.3</Version>
    <FileVersion>1.0.3.0</FileVersion>
    <Product>TDN Control</Product>
    <Company>TDN Media</Company>
    <Copyright>© 2026 TDN Media</Copyright>
    <Description>TDN Control - bảng điều khiển các ứng dụng TDN Media</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TDNControl.Tests" />
    <Compile Remove="Tests\**" />
    <EmbeddedResource Include="Assets\logo.jpg" LogicalName="logo.jpg" />
    <EmbeddedResource Include="Assets\logo-d.png" LogicalName="logo-d.png" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>
</Project>
